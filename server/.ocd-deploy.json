{
  "$schema": 1,
  "$llm": "https://ocd.cero-ai.com/llm.txt",
  "name": "Zero Agent \u2014 Server",
  "description": "API server with real-time chat, agent orchestration, and multi-provider LLM support",
  "suggested_app_name": "zero-server",
  "build": {
    "repository": "https://github.com/0-AI-UG/zero-agent.git",
    "branch": "main",
    "dockerfile": "server/Dockerfile",
    "context": ".",
    "image_repository": "ghcr.io/0-ai-ug/zero-agent/zero-server",
    "webhook": true
  },
  "volume": {
    "size": 20,
    "path": "/app/data"
  },
  "env": {
    "CORS_ORIGIN": "*",
    "JWT_SECRET": {
      "from": "environment.JWT_SECRET"
    },
    "LOG_LEVEL": "info",
    "PI_PROJECTS_ROOT": "/app/data/projects",
    "RP_ID": "localhost",
    "RP_NAME": "ZeroAgent"
  },
  "environment": "zero-server",
  "container_port": 3000
}
